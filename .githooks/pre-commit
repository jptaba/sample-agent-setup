#!/usr/bin/env bash
# Pre-commit guardrails: branch protection, secret scan, skill validation, file-size limit.
# Install: git config core.hooksPath .githooks
set -uo pipefail

# 1. Block direct commits to main/master.
branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo detached)"
if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
  echo "pre-commit: blocked — don't commit directly to '$branch'. Create a branch and open a PR."
  exit 1
fi

# 2. Secret scan on staged files.
if ! bash .agents/skills/review/scripts/scan-secrets.sh --staged; then
  echo "pre-commit: blocked — possible secret in staged files."
  exit 1
fi

# 3. Skill spec validation (fast; runs every commit).
if ! bash .agents/skills/review/scripts/validate-skills.sh; then
  echo "pre-commit: blocked — skill spec violation."
  exit 1
fi

# 4. Block files larger than 1 MB.
big="$(git diff --cached --name-only --diff-filter=ACM | while read -r f; do
  [ -f "$f" ] || continue
  size="$(wc -c < "$f")"
  [ "$size" -gt 1048576 ] && echo "$f ($size bytes)"
done)"
if [ -n "$big" ]; then
  echo "pre-commit: blocked — files over 1 MB:"
  echo "$big"
  exit 1
fi

echo "pre-commit: OK"
